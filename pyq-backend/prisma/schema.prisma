// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// ENUMS
// =========================

enum Stage {
  SECONDARY
  SENIOR_SECONDARY
  DEGREE
  PG
}

enum PaperType {
  ANNUAL
  HALF_YEARLY
  MODEL
  INTERNAL
  OTHER
}

enum PaperStatus {
  PENDING
  APPROVED
  REJECTED
}

// =========================
// SUBJECTS
// =========================

model Subject {
  id        String   @id @default(cuid())

  // Display name
  name      String

  // Optional short code (ADB, ENG, FIQH)
  code      String?

  // Fixed structure
  stage     Stage
  year      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  papers    Paper[]

  // Prevent duplicate subjects in same stage/year
  @@unique([stage, year, name], name: "stage_year_name")

  // Faster filtering
  @@index([stage, year])
}

// =========================
// PAPERS
// =========================

model Paper {
  id            String      @id @default(cuid())

  title         String
  examYear      Int

  paperType     PaperType

  pdfUrl        String
  fileSize      Int?

  status        PaperStatus @default(PENDING)

  // Relation
  subjectId     String
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Optional uploader info
  uploaderName  String?
  uploaderEmail String?

  approvedAt    DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Faster filtering
  @@index([status])
  @@index([examYear])
  @@index([subjectId])
}

// =========================
// SUBJECT SUGGESTIONS
// =========================

model SubjectSuggestion {
  id          String   @id @default(cuid())

  name        String

  stage       Stage
  year        Int

  suggestedBy String?

  // pending / approved / rejected
  status      String   @default("pending")

  createdAt   DateTime @default(now())

  @@index([stage, year])
  @@index([status])
}